---
import Base from "../../../layouts/Base.astro";
import SystemPage from "../../../components/SystemPage.astro";
import { workSystems } from "../../../content/systems";

export function getStaticPaths() {
  return workSystems.map((system) => ({
    params: { slug: system.slugs.en },
    props: { system },
  }));
}

const { system } = Astro.props;
---

<Base locale="en" title={system.titles.en} description={system.leads.en}>
  <SystemPage system={system} locale="en" />
</Base>
