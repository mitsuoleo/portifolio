---
import Base from "../../layouts/Base.astro";
import SystemPage from "../../components/SystemPage.astro";
import { workSystems } from "../../content/systems";

export function getStaticPaths() {
  return workSystems.map((system) => ({
    params: { slug: system.slugs.pt },
    props: { system },
  }));
}

const { system } = Astro.props;
---

<Base locale="pt" title={system.titles.pt} description={system.leads.pt}>
  <SystemPage system={system} locale="pt" />
</Base>
