---
import type { Locale } from "../config";
import { copy } from "../copy";
import { labSystems } from "../content/systems";
import SystemRow from "./SystemRow.astro";

const { locale } = Astro.props as { locale: Locale };
const t = copy[locale];
---

<main id="content" class="shell page">
  <h1>{t.labTitle}</h1>
  <p class="bio editorial">{t.labLead}</p>
  <div class="systems">
    {labSystems.map((s) => <SystemRow system={s} locale={locale} />)}
  </div>
</main>
