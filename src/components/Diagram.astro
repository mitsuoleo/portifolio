---
type Kind = "commerce-intelligence" | "catalog" | "pipeline" | "shortener" | "promptvault";
const { kind } = Astro.props as { kind: Kind };
---

{
  kind === "commerce-intelligence" && (
    <svg class="diagram" viewBox="0 0 420 160" fill="none" role="img" aria-label="Ingest, warehouse, serve">
      <rect x="8" y="48" width="110" height="64" stroke="currentColor" />
      <text x="63" y="84" text-anchor="middle" fill="currentColor" font-size="11">INGEST</text>
      <path d="M118 80h36" stroke="currentColor" />
      <rect x="154" y="36" width="120" height="88" stroke="currentColor" />
      <text x="214" y="72" text-anchor="middle" fill="currentColor" font-size="11">WAREHOUSE</text>
      <text x="214" y="92" text-anchor="middle" fill="currentColor" font-size="9" opacity="0.7">facts · dims</text>
      <path d="M274 80h36" stroke="currentColor" />
      <rect x="310" y="48" width="102" height="64" stroke="currentColor" />
      <text x="361" y="84" text-anchor="middle" fill="currentColor" font-size="11">SERVE</text>
    </svg>
  )
}
{
  kind === "catalog" && (
    <svg class="diagram" viewBox="0 0 220 120" fill="none" aria-hidden="true">
      <rect x="8" y="18" width="62" height="84" stroke="currentColor" stroke-width="1.2" />
      <text x="39" y="40" text-anchor="middle" fill="currentColor" font-size="8">SKU</text>
      <rect x="18" y="50" width="42" height="10" stroke="currentColor" />
      <rect x="18" y="66" width="42" height="10" stroke="currentColor" />
      <rect x="18" y="82" width="28" height="10" fill="currentColor" opacity="0.2" stroke="currentColor" />
      <path d="M70 60h28" stroke="currentColor" />
      <rect x="98" y="28" width="114" height="64" stroke="currentColor" stroke-width="1.2" />
      <text x="155" y="50" text-anchor="middle" fill="currentColor" font-size="8">on-hand ≥ 0</text>
      <path d="M112 72h86" stroke="currentColor" opacity="0.5" />
      <text x="155" y="88" text-anchor="middle" fill="currentColor" font-size="7">receive · adjust</text>
    </svg>
  )
}
{
  kind === "pipeline" && (
    <svg class="diagram" viewBox="0 0 220 120" fill="none" aria-hidden="true">
      <circle cx="28" cy="60" r="14" stroke="currentColor" />
      <circle cx="88" cy="36" r="14" stroke="currentColor" />
      <circle cx="88" cy="84" r="14" stroke="currentColor" />
      <circle cx="160" cy="60" r="14" stroke="currentColor" />
      <path d="M42 54 L74 40" stroke="currentColor" />
      <path d="M42 66 L74 80" stroke="currentColor" />
      <path d="M102 40 L146 54" stroke="currentColor" />
      <path d="M102 80 L146 66" stroke="currentColor" />
    </svg>
  )
}
{
  kind === "shortener" && (
    <svg class="diagram" viewBox="0 0 220 120" fill="none" aria-hidden="true">
      <path d="M16 40h70v40H16z" stroke="currentColor" />
      <text x="51" y="64" text-anchor="middle" fill="currentColor" font-size="8">GET /x</text>
      <path d="M86 60h28" stroke="currentColor" />
      <path d="M114 28h90v28H114z" stroke="currentColor" />
      <text x="159" y="46" text-anchor="middle" fill="currentColor" font-size="8">Redis → 302</text>
      <path d="M114 76h90v28H114z" stroke="currentColor" stroke-dasharray="3 3" />
      <text x="159" y="94" text-anchor="middle" fill="currentColor" font-size="8">stream</text>
    </svg>
  )
}
{
  kind === "promptvault" && (
    <svg class="diagram" viewBox="0 0 220 120" fill="none" aria-hidden="true">
      <rect x="40" y="24" width="140" height="72" stroke="currentColor" />
      <path d="M56 48h108M56 64h80M56 80h64" stroke="currentColor" opacity="0.6" />
    </svg>
  )
}
