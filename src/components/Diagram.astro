---
type Kind = "observa" | "pipeline" | "shortener" | "promptvault";
const { kind } = Astro.props as { kind: Kind };
---

{
  kind === "observa" && (
    <svg class="diagram" viewBox="0 0 420 160" fill="none" role="img" aria-label="Order, Kafka, Payment, Inventory, OpenTelemetry e Grafana">
      <rect x="8" y="16" width="84" height="46" stroke="currentColor" />
      <text x="50" y="43" text-anchor="middle" fill="currentColor" font-size="10">ORDER</text>
      <path d="M92 39h28" stroke="currentColor" />
      <rect x="120" y="16" width="84" height="46" stroke="currentColor" />
      <text x="162" y="43" text-anchor="middle" fill="currentColor" font-size="10">KAFKA</text>
      <path d="M204 39h28" stroke="currentColor" />
      <rect x="232" y="16" width="180" height="46" stroke="currentColor" />
      <text x="322" y="43" text-anchor="middle" fill="currentColor" font-size="10">PAYMENT · INVENTORY</text>
      <path d="M50 62v57h70" stroke="currentColor" stroke-dasharray="3 3" />
      <path d="M322 62v57h-94" stroke="currentColor" stroke-dasharray="3 3" />
      <rect x="120" y="96" width="108" height="46" stroke="currentColor" />
      <text x="174" y="123" text-anchor="middle" fill="currentColor" font-size="10">OTEL</text>
      <path d="M228 119h60" stroke="currentColor" />
      <rect x="288" y="96" width="124" height="46" stroke="currentColor" />
      <text x="350" y="123" text-anchor="middle" fill="currentColor" font-size="10">GRAFANA</text>
    </svg>
  )
}
{
  kind === "pipeline" && (
    <svg class="diagram" viewBox="0 0 220 120" fill="none" aria-hidden="true">
      <circle cx="28" cy="60" r="14" stroke="currentColor" />
      <circle cx="88" cy="36" r="14" stroke="currentColor" />
      <circle cx="88" cy="84" r="14" stroke="currentColor" />
      <circle cx="160" cy="60" r="14" stroke="currentColor" />
      <path d="M42 54 L74 40" stroke="currentColor" />
      <path d="M42 66 L74 80" stroke="currentColor" />
      <path d="M102 40 L146 54" stroke="currentColor" />
      <path d="M102 80 L146 66" stroke="currentColor" />
    </svg>
  )
}
{
  kind === "shortener" && (
    <svg class="diagram" viewBox="0 0 220 120" fill="none" aria-hidden="true">
      <path d="M16 40h70v40H16z" stroke="currentColor" />
      <text x="51" y="64" text-anchor="middle" fill="currentColor" font-size="8">GET /x</text>
      <path d="M86 60h28" stroke="currentColor" />
      <path d="M114 28h90v28H114z" stroke="currentColor" />
      <text x="159" y="46" text-anchor="middle" fill="currentColor" font-size="8">Redis → 302</text>
      <path d="M114 76h90v28H114z" stroke="currentColor" stroke-dasharray="3 3" />
      <text x="159" y="94" text-anchor="middle" fill="currentColor" font-size="8">stream</text>
    </svg>
  )
}
{
  kind === "promptvault" && (
    <svg class="diagram" viewBox="0 0 220 120" fill="none" aria-hidden="true">
      <rect x="40" y="24" width="140" height="72" stroke="currentColor" />
      <path d="M56 48h108M56 64h80M56 80h64" stroke="currentColor" opacity="0.6" />
    </svg>
  )
}
