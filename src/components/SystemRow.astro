---
import type { Locale } from "../config";
import type { System } from "../content/systems";
import { copy } from "../copy";
import { systemHref } from "../content/systems";
import { techCategory } from "../tech-category";

type Props = { system: System; locale: Locale };

const { system, locale } = Astro.props;
const t = copy[locale];
const hues: Record<string, number> = {
  mercadoone: 145,
  observa: 210,
  pipeline: 268,
  shortener: 28,
  promptvault: 320,
};
const hue = hues[system.id] ?? 160;
const mark = system.id === "mercadoone" ? "M1" : system.titles[locale].slice(0, 1);
---

<a class:list={{ "system-row": true, "system-row-primary": system.id === "mercadoone" }} href={systemHref(system, locale)} data-system data-domain={system.domain} data-year={system.year} data-status={system.status} data-tech={system.stack.map((s) => s.name).join(",")} style={`--hue: ${hue}`}>
  <div class="system-thumb">
    <span class="system-thumb-domain">{t.domains[system.domain]}</span>
    <span class="system-thumb-mark" aria-hidden="true">{mark}</span>
    <span class="system-thumb-domain">{system.year}</span>
  </div>
  <div class="system-meta">
    <div>
      <h3 class="system-title">{system.titles[locale]}</h3>
      <p class="system-description">{system.leads[locale]}</p>
      <ul class="system-tech" aria-label={t.stack}>
        {system.stack.map((tech) => <li class="tech-tag" data-category={techCategory(tech.name)}>{tech.name}</li>)}
      </ul>
    </div>
    <div class="icon-btns" aria-hidden="true">
      <span>↗</span>
    </div>
  </div>
</a>
