---
import type { Locale } from "../config";
import { owner } from "../config";
import { copy } from "../copy";

const { locale } = Astro.props as { locale: Locale };
const t = copy[locale];
const items = [
  {
    href: owner.github,
    label: t.github,
    icon: "github",
  },
  owner.linkedin && {
    href: owner.linkedin,
    label: t.linkedin,
    icon: "linkedin",
  },
  owner.email && {
    href: `mailto:${owner.email}`,
    label: t.email,
    icon: "mail",
  },
].filter(Boolean) as { href: string; label: string; icon: string }[];
---

<nav class="social enter delay-3" aria-label={t.hire}>
  {
    items.map((item) => (
      <a href={item.href} aria-label={item.label}>
        {item.icon === "github" && (
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 .5A11.5 11.5 0 0 0 .5 12.4c0 5.25 3.4 9.7 8.12 11.27.6.1.82-.26.82-.58v-2.03c-3.3.73-4-1.6-4-1.6-.54-1.38-1.32-1.75-1.32-1.75-1.08-.75.08-.73.08-.73 1.2.08 1.83 1.24 1.83 1.24 1.06 1.84 2.78 1.3 3.46 1 .1-.8.41-1.31.75-1.61-2.64-.3-5.42-1.34-5.42-5.96 0-1.32.46-2.4 1.23-3.25-.12-.3-.53-1.52.12-3.17 0 0 1-.33 3.3 1.24a11.3 11.3 0 0 1 6 0c2.28-1.57 3.28-1.24 3.28-1.24.66 1.65.25 2.87.12 3.17.77.85 1.23 1.93 1.23 3.25 0 4.63-2.78 5.65-5.43 5.95.42.37.8 1.1.8 2.22v3.29c0 .32.21.7.83.58A11.5 11.5 0 0 0 23.5 12.4 11.5 11.5 0 0 0 12 .5Z" />
          </svg>
        )}
        {item.icon === "linkedin" && (
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4.98 3.5A2.48 2.48 0 1 0 5 8.46a2.48 2.48 0 0 0-.02-4.96ZM3.5 9.2h3v11.3h-3Zm5.5 0h2.88v1.55h.04c.4-.76 1.38-1.56 2.84-1.56 3.04 0 3.6 2 3.6 4.6v6.71h-3v-5.95c0-1.42-.03-3.24-1.97-3.24-1.97 0-2.27 1.54-2.27 3.13v6.06h-3Z" />
          </svg>
        )}
        {item.icon === "mail" && (
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M3 5.5A2.5 2.5 0 0 1 5.5 3h13A2.5 2.5 0 0 1 21 5.5v13a2.5 2.5 0 0 1-2.5 2.5h-13A2.5 2.5 0 0 1 3 18.5Zm1.6.7 7.4 5.1 7.4-5.1v-.7l-7.4 5.1L4.6 5.5Z" />
          </svg>
        )}
      </a>
    ))
  }
</nav>
