---
import type { Locale } from "../config";
import { copy } from "../copy";
import { featuredSystems, systemHref, type SystemId } from "../content/systems";
import HireActions from "./HireActions.astro";

const { locale } = Astro.props as { locale: Locale };
const t = copy[locale];
const notes: Record<SystemId, Record<Locale, string>> = {
  mercadoone: {
    pt: "O caixa grava a venda no SQLite e a API confirma ou registra o conflito.",
    en: "The POS stores the sale in SQLite, and the API confirms it or records a conflict.",
  },
  observa: {
    pt: "Serviços em Python e Node.js trocam eventos Kafka, e o Grafana junta trace, métrica e log.",
    en: "Python and Node.js services exchange Kafka events, and Grafana joins the trace, metric, and log.",
  },
  pipeline: {
    pt: "O pedido entra por FastAPI e segue no RabbitMQ, com estorno quando o estoque falta.",
    en: "The order enters through FastAPI and continues on RabbitMQ, with a refund when stock is missing.",
  },
  shortener: {
    pt: "Go responde o redirect com Redis na frente e grava o clique num stream, fora da resposta.",
    en: "Go answers the redirect from Redis and records the click on a stream, outside the response.",
  },
  promptvault: { pt: "", en: "" },
};
---

<main id="content" class="shell page">
  <h1>{t.profileTitle}</h1>
  <p class="role">{t.role} · {t.place}</p>
  <p class="lead-display editorial">{t.profileLead}</p>
  <div class="prose">
    <h2>{t.profileHowTitle}</h2>
    <ul>
      {t.profileHow.map((item) => <li>{item}</li>)}
    </ul>
    <h2>{t.systems}</h2>
    <ul>
      {
        featuredSystems.map((system) => (
          <li>
            <a href={systemHref(system, locale)}>{system.titles[locale]}</a>
            {" — "}
            {notes[system.id][locale]}
          </li>
        ))
      }
    </ul>
    <h2>{t.profileSkillsTitle}</h2>
    <p>{t.profileSkills}</p>
  </div>
  <HireActions locale={locale} />
</main>
