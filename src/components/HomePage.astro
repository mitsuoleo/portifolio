---
import type { Locale } from "../config";
import { owner, pagePath } from "../config";
import { copy } from "../copy";
import { featuredSystems } from "../content/systems";
import HireActions from "./HireActions.astro";
import SocialIcons from "./SocialIcons.astro";
import StatusBlock from "./StatusBlock.astro";
import SystemRow from "./SystemRow.astro";
import { techCategory } from "../tech-category";

const { locale } = Astro.props as { locale: Locale };
const t = copy[locale];
const roleParts = t.role.split(" ");
const stack = ["Python", "Java", "TypeScript", "JavaScript", "PostgreSQL", "SQLite", "Kafka", "Docker", "Go", "Redis", "OpenTelemetry"];
const notes = locale === "pt"
  ? [
      "Mercado One / produto → estoque → venda",
      "PDV / SQLite local → sincronização",
      "API Java / Spring Boot + PostgreSQL",
      "Admin web / catálogo e relatórios",
      "Observa / eventos Kafka entre serviços",
      "Observa / traces, métricas e logs",
      "Pipeline / pagamento → estoque",
      "Encurtador / Redis → PostgreSQL → 302",
    ]
  : [
      "Mercado One / product → inventory → sale",
      "POS / local SQLite → sync",
      "Java API / Spring Boot + PostgreSQL",
      "Web admin / catalog and reports",
      "Observa / Kafka events across services",
      "Observa / traces, metrics, and logs",
      "Pipeline / payment → inventory",
      "Shortener / Redis → PostgreSQL → 302",
    ];
---

<main id="content" class="shell">
  <section class="hero">
    <div class="hero-text">
      <p class="kicker enter">{t.hi} <strong>{owner.name}</strong></p>
      <h1 class="enter delay-1">
        {roleParts[0]}
        <br />
        {roleParts.slice(1).join(" ")}
      </h1>
      <p class="lead-display enter delay-2">{t.heroBefore}<span class="accent">{t.heroAccent}</span>{t.heroAfter}</p>
      <SocialIcons locale={locale} />
    </div>
  </section>

  <div class="marquee" aria-label={t.stack}>
    <div class="marquee-track">
      <ul class="tags">
        {stack.map((name) => <li class="tech-tag" data-category={techCategory(name)}>{name}</li>)}
      </ul>
      <ul class="tags" aria-hidden="true">
        {stack.map((name) => <li class="tech-tag" data-category={techCategory(name)}>{name}</li>)}
      </ul>
    </div>
  </div>

  <div class="section-head enter delay-3">
    <h2 class="display">{t.areasTitle}</h2>
  </div>
  <div class="do-grid" data-reveal>
    <div class="areas">
      {
        t.areas.map((a) => (
          <article class="area">
            <h3>{a.title}</h3>
            <p>{a.body}</p>
          </article>
        ))
      }
    </div>
    <div class="code-rain" aria-hidden="true">
      <div class="code-rain-track">
        <ul>{notes.map((note) => <li>{note}</li>)}</ul>
        <ul aria-hidden="true">{notes.map((note) => <li>{note}</li>)}</ul>
      </div>
    </div>
  </div>

  <div class="section-head" data-reveal>
    <p class="section-label">{t.workEyebrow}</p>
    <h2>{t.systems}</h2>
  </div>
  <div class="systems home-systems" data-reveal>
    {featuredSystems.map((s) => <SystemRow system={s} locale={locale} />)}
  </div>

  <StatusBlock locale={locale} />

  <div class="profile-strip" data-reveal>
    <p class="bio editorial">{t.profileBlurb}</p>
    <a class="btn" href={pagePath("profile", locale)}>{t.profileCta}</a>
  </div>

  <section class="cta-band" data-reveal>
    <p class="section-label">{t.contactTitle}</p>
    <h2>{t.contactCta}</h2>
    <p class="lead">{t.contactLead}</p>
    <HireActions locale={locale} />
  </section>
</main>
